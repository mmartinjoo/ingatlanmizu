  create view "ingatlanmizu"."silver"."int_zenga__price_changes__dbt_tmp"
    
    
  as (
    with versions as (
    select * from "ingatlanmizu"."silver"."stg_zenga__listing_versions"
),

with_previous as (
    select
        listing_code,
        observed_at,
        price,
        lag(price) over (
            partition by listing_code
            order by observed_at, bronze_id
        ) as previous_price
    from versions
)

select
    listing_code,
    observed_as,
    previous_price,
    price as new_price,
    price - previous_price as price_delta,
    round(
        ((price - price_previous)::numeric / previous_price) * 100,
        2
    ) as price_change_pct
from with_previous
where precious_price is not null
and price is distinct from previous_price
  );
