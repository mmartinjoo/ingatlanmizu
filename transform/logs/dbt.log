  create view "ingatlanmizu"."silver"."stg_zenga__listings__dbt_tmp"
    
    
  as (
    with 
    source as (
        select * from "ingatlanmizu"."bronze"."zenga_listings"
    ),

    versioned as (
        select 
            *,
            row_number() over (
                partition by hirdeteskod
                order by created_at desc, id desc
            ) as version_rank
        from source
    ),

    latest as (
        select * 
        from versioned
        where version_rank = 1
    ),

    renamed as (
        select
            megnevezes as title,
            ar as price,
            negyzetmeter_ar as price_per_square_meter,
            cim as address,
            alapterulet as area,
            telek as plot_size,
            emelet as floor,
            szobak_szama as number_of_rooms,
            leiras as description,
            hirdeteskod as listing_code,
            referenciaszam as reference_number,
            allapot as condition,
            futes as heating,
            epites_eve as year_of_building,
            terasz as balcony,
            energetikai_besorolas as energy_rating,
            tipus as type,
            szintek_szama as max_number_of_floors_in_building
        from latest
    )

select * from renamed
  );
