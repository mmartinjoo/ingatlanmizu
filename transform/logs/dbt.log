        where version_rank = 1
    ),

    renamed as (
        select
            megnevezes as title,
            (-- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(column, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric)::bigint as price,
            ltrim(rtrim(split_part(column, ',', 1)))
 as city,
            ltrim(rtrim(split_part(column, ',', 2)))
 as location_detail,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
