  create view "ingatlanmizu"."silver"."stg_zenga__listings__dbt_tmp"
    
    
  as (
    with 
    source as (
        select * from "ingatlanmizu"."bronze"."zenga_listings"
    ),

    versioned as (
        select 
            *,
            row_number() over (
                partition by hirdeteskod
                order by created_at desc, id desc
            ) as version_rank
        from source
    ),

    latest as (
        select * 
        from versioned
        where version_rank = 1
    ),

    renamed as (
        select
            megnevezes as title,
            (-- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(ar, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric * -- Returns the magnitude of a human-readable price
-- "49,9 millió Ft" -> 1000000
case
    when ar ilike '%milliárd%'  then 1000000000
    when ar ilike '%millió%'    then 1000000
    when ar ilike '%ezer%'      then 1000
    else 1
end)::bigint as price,
            btrim(split_part(cim, ',', 1))
 as city,
            nullif(btrim(split_part(cim, ',', 2)), '')
 as location_detail,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(alapterulet, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as area,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(telek, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as plot_size,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(emelet, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as floor,
            coalesce(substring(szobak_szama from '(^\d+)')::numeric, 0)
    + (coalesce(substring(szobak_szama from '\+\s*(\d+)')::numeric, 0) * 0.5)
 as number_of_rooms,
            szobak_szama as number_of_rooms_raw,
            leiras as description,
            hirdeteskod as listing_code,
            allapot as condition,
            futes as heating,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(epites_eve, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as year_of_building,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(terasz, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as balcony_area,
            energetikai_besorolas as energy_rating,
            tipus as type,
            szintek_szama as max_number_of_floors_in_building,
            created_at as created_at,
            ingestion_run_id as ingestion_run_id
        from latest
    )

select * from renamed
  );
