  create view "ingatlanmizu"."silver"."stg_zenga__listing_versions__dbt_tmp"
    
    
  as (
    with 
    source as (
        select * 
        from "ingatlanmizu"."bronze"."zenga_listing_versions"
        where ar is not null
        and alapterulet is not null
        and tipus is not null
        and tipus != 'Villa, kastély'
    ),

    renamed as (
        select
            id as bronze_id,
            hirdeteskod as listing_code,
            concat('zenga', ':', hirdeteskod) as listing_key,
            'zenga' as source,
            megnevezes as title,
            (-- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(ar, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric * -- Returns the magnitude of a human-readable price
-- "49,9 millió Ft" -> 1000000
case
    when ar ilike '%milliárd%'  then 1000000000
    when ar ilike '%millió%'    then 1000000
    when ar ilike '%ezer%'      then 1000
    else 1
end)::bigint as price_huf,
            ((-- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(ar, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric * -- Returns the magnitude of a human-readable price
-- "49,9 millió Ft" -> 1000000
case
    when ar ilike '%milliárd%'  then 1000000000
    when ar ilike '%millió%'    then 1000000
    when ar ilike '%ezer%'      then 1000
    else 1
end) / -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(alapterulet, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric)::int as price_per_square_meter,
            btrim(split_part(cim, ',', 1))
 as city,
            nullif(btrim(split_part(cim, ',', 2)), '')
 as location_detail,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(alapterulet, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as area_sqm,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(telek, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as plot_size,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(emelet, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as floor,
            emelet as floor_raw,
            coalesce(substring(szobak_szama from '(^\d+)')::numeric, 0)
    + (coalesce(substring(szobak_szama from '\+\s*(\d+)')::numeric, 0) * 0.5)
 as number_of_rooms,
            szobak_szama as number_of_rooms_raw,
            leiras as description,
            futes as heating,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(epites_eve, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as year_of_building,
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(terasz, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as balcony_area,
            -- JJ (2016-2023-as besorolás) -> JJ
            regexp_replace(energetikai_besorolas, '\s+\(.*', '') as energy_rating,            
            -- Converts human-readable numeric values to a number
-- "49,9 millió Ft" -> 49.9 
-- "65 m²" -> 65
-- Non-breaking spaces (chr(160)) are replaced to spaces
-- It returns NULL if the result is empty
nullif(
    replace(
        regexp_replace(
            replace(szintek_szama, chr(160), ' '), 
            '[^0-9,]', '', 'g'
        ), ',', '.'
    ), ''
)::numeric as max_number_of_floors_in_building,
            created_at as observed_at,
            ingestion_run_id as ingestion_run_id,
            payload_hash as payload_hash,
            hirdeto_neve as seller_name,
            ingatlan_iroda_neve as real_estate_office_name,
            tipus as sub_type,
            megye as county,
            case
                when tipus ilike '%ház%'     then 'Ház'
                when tipus ilike '%lakás%'   then 'Lakás'
                else null       -- this will cause a data test error
            end as main_type,
            case
                when allapot is null then   'Ismeretlen'
                when allapot = '' then      'Ismeretlen'
                else allapot
            end as condition
        from source
    )

select * from renamed
  );
