  create  table "ingatlanmizu"."gold"."mart_listings_current__dbt_tmp"
  
  
    as
  
  (
    with 
	price_change_counts as (
		select 
			listing_code,
			count(listing_code) as price_changes_count
		from silver.int_zenga__price_changes
		group by listing_code
	),
	
	oldest_prices as (
		select listing_code, previous_price_huf as oldest_price
		from silver.int_zenga__price_changes
		order by observed_at asc
		limit 1
	),
	
	latest_prices as (
		select listing_code, new_price_huf as latest_price
		from silver.int_zenga__price_changes
		order by observed_at desc
		limit 1
	)

select 
	listings.*,
	price_change_counts.price_changes_count,
	oldest_prices.oldest_price as original_price_huf,
	latest_prices.latest_price as current_price_huf,
	oldest_prices.oldest_price - latest_prices.latest_price as price_delta_huf,
	round(
		((oldest_prices.oldest_price - latest_prices.latest_price)::numeric / oldest_prices.oldest_price)*100, 
		2
	) as price_change_pct
from silver.int_listings__unioned as listings
left join price_change_counts
on listings.listing_code = price_change_counts.listing_code
left join oldest_prices
on listings.listing_code = oldest_prices.listing_code
left join latest_prices
on listings.listing_code = latest_prices.listing_code
  );
  
