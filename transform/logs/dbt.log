  create view "ingatlanmizu"."silver"."int_listings__monthly__dbt_tmp"
    
    
  as (
    with listing_months as (
    select distinct
        listing_key,
        date_trunc('month', observed_at)::date as month_start
    from "ingatlanmizu"."silver"."int_observations__unioned"
)

select distinct on (listing_months.listing_key, listing_months.month_start)
    listing_months.month_start,
    listing_months.listing_key,
    versions.city,
    versions.main_type,
    versions.sub_type,
    versions.price_huf,
    versions.area_sqm
from listing_months
join "ingatlanmizu"."silver"."int_listing_versions__unioned" as versions
    on versions.listing_key = listing_months.listing_key
    and versions.observed_at < listing_months.month_start + interval '1 month'
order by
    listing_months.listing_key,
    listing_months.month_start,
    versions.observed_at desc,
    versions.bronze_id desc
  );
[0m00:44:32.620046 [debug] [Thread-3 (]: On model.ingatlanmizu.int_listings__price_changes: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "ingatlanmizu", "target_name": "local", "node_id": "model.ingatlanmizu.int_listings__price_changes"} */

  create view "ingatlanmizu"."silver"."int_listings__price_changes__dbt_tmp"
    
    
  as (
    with versions as (
    select * from "ingatlanmizu"."silver"."int_listing_versions__unioned"
),

with_previous as (
    select
        listing_key,
        observed_at,
        price_huf,
        lag(price_huf) over (
            partition by listing_key
            order by observed_at, bronze_id
        ) as previous_price_huf
    from versions
)

select
    listing_key,
    observed_at,
    previous_price_huf,
    price_huf as new_price_huf,
    price_huf - previous_price_huf as price_delta_huf,
    round(
        ((price_huf - previous_price_huf)::numeric / previous_price_huf) * 100,
        2
    ) as price_change_pct
from with_previous
where previous_price_huf is not null
and price_huf is distinct from previous_price_huf
  );
